# BCP Calculator — OpenAI Direct Configuration
#
# Use this file when running BCP Calculator against OpenAI's API directly
# (api.openai.com). Requires a real OpenAI API key.
#
# Copy to .env and adjust as needed:
#   cp .env.openai.example .env

# Provider: uses SimpleLLMProvider (default) with httpx
# The "openai" provider name maps to SimpleLLMProvider

# OpenAI API key (required — real key, not a placeholder)
OPENAI_API_KEY=sk-your-real-openai-api-key

# Base URL (optional — defaults to https://api.openai.com/v1)
OPENAI_BASE_URL=https://api.openai.com/v1

# Model (recommended: mistral-small-2503 with temperature=0 for lowest CV)
OPENAI_MODEL_NAME=mistral-small-2503

# Log level
LOG_LEVEL=INFO
