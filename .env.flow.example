# BCP Calculator — Flow OpenAI (LiteLLM Proxy) Configuration
#
# Use this file when running BCP Calculator against Flow's LiteLLM proxy
# via the FlowLiteLLM provider (--provider flow-openai).
# Auth is handled via Azure AD B2C M2M (OAuth2 client_credentials grant).
#
# Copy to .env and adjust as needed:
#   cp .env.llm-provider.example .env

# Provider: use --provider flow-openai on CLI / SDK / API
# This uses FlowLiteLLMProvider (langchain-based, Azure B2C auth)

# Flow LiteLLM proxy URL (required)
FLOW_LLM_LITE_HOST=https://flow.ciandt.com/flow-litellm

# Model (recommended: mistral-small-2503 with temperature=0 for lowest CV)
FLOW_LITELLM_MODEL_NAME=mistral-small-2503

# Max tokens
FLOW_LITELLM_MAX_TOKENS=4096

# Temperature (recommended: 0 for deterministic output)
FLOW_LITELLM_TEMPERATURE=0

# Azure B2C M2M credentials (required for auth)
B2C_TENANT=citflowdevb2c.onmicrosoft.com
FLOW_LITELLM_CLIENT_ID=<app-registration-client-id-for-flow-litellm>
FLOW_LITELLM_CLIENT_SECRET=<app-registration-client-secret-for-flow-litellm>

# Scope URI (option 1 — direct env var):
FLOW_LITELLM_SCOPE=https://citflowdevb2c.onmicrosoft.com/citflowdev_app_flow-litellm_sys_sa/.default

# Scope URI (option 2 — via ACCESS_SCOPES JSON, alternative to FLOW_LITELLM_SCOPE):
# ACCESS_SCOPES={"flow-litellm":"https://citflowdevb2c.onmicrosoft.com/citflowdev_app_flow-litellm_sys_sa/.default"}

# Flow shared settings
FLOW_TENANT=flowteam
FLOW_AGENT=bcp-opensource

# Log level
LOG_LEVEL=INFO
