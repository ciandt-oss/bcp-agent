# BCP Calculator — HuggingFace Inference Providers Configuration
#
# Use this file when running BCP Calculator against HuggingFace Inference Providers.
# Access 100+ hosted open-source models via HuggingFace's router.
#
# Copy to .env and adjust as needed:
#   cp .env.huggingface.example .env

# Provider: use --provider huggingface on CLI / SDK / API
# Uses SimpleLLMProvider with HuggingFace's OpenAI-compatible endpoint

# HuggingFace token (required — get one at https://huggingface.co/settings/tokens)
# Needs "Make calls to Inference Providers" permission
HF_TOKEN=hf_...

# Model (default: zai-org/GLM-5.2:novita)
# Browse available models at https://huggingface.co/models?inference_provider=all
HF_MODEL_NAME=zai-org/GLM-5.2:novita

# Log level
LOG_LEVEL=INFO
