# BCP Calculator — Flow Bedrock Configuration
#
# Use this file when running BCP Calculator against Flow's Bedrock endpoint
# via the FlowLiteLLM provider (--provider flow-bedrock).
#
# Copy to .env and adjust as needed:
#   cp .env.flow-bedrock.example .env

# Provider: use --provider flow-bedrock on CLI / SDK / API
# This uses FlowLiteLLMProvider with Bedrock-specific settings

# Bedrock model name (default: mistral-small-2503)
FLOW_BEDROCK_MODEL_NAME=mistral-small-2503

# Max tokens for Bedrock (default: 1000)
FLOW_BEDROCK_MAX_TOKENS=1000

# Temperature (recommended: 0 for deterministic output)
FLOW_BEDROCK_TEMPERATURE=0

# Flow Bedrock specific settings (optional overrides)
# FLOW_BEDROCK_TOP_P=0.999
# FLOW_BEDROCK_TOP_K=250
# FLOW_BEDROCK_ANTHROPIC_VERSION=bedrock-2023-05-31

# Azure B2C M2M credentials (required for Flow auth)
# B2C_TENANT=citflowdevb2c.onmicrosoft.com
# FLOW_LITELLM_CLIENT_ID=<app-registration-client-id-for-flow-litellm>
# FLOW_LITELLM_CLIENT_SECRET=<app-registration-client-secret-for-flow-litellm>

# Scope URI (option 1 — direct env var):
# FLOW_LITELLM_SCOPE=https://citflowdevb2c.onmicrosoft.com/citflowdev_app_flow-litellm_sys_sa/.default

# Scope URI (option 2 — via ACCESS_SCOPES JSON):
# ACCESS_SCOPES={"flow-litellm":"https://citflowdevb2c.onmicrosoft.com/citflowdev_app_flow-litellm_sys_sa/.default"}

# Flow shared settings
# FLOW_TENANT=flowteam
# FLOW_AGENT=bcp-opensource

# Log level
LOG_LEVEL=INFO
