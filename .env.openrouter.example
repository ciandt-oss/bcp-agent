# BCP Calculator — OpenRouter Configuration
#
# Use this file when running BCP Calculator against OpenRouter.
# OpenRouter provides access to 300+ models via a single API.
#
# Copy to .env and adjust as needed:
#   cp .env.openrouter.example .env

# Provider: use --provider openrouter on CLI / SDK / API
# Uses SimpleLLMProvider with OpenRouter's OpenAI-compatible endpoint

# OpenRouter API key (required — get one at https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-...

# Model (default: openai/gpt-6-luna)
# Browse available models at https://openrouter.ai/models
OPENROUTER_MODEL_NAME=openai/gpt-6-luna

# Optional: app attribution headers (makes your app discoverable on openrouter.ai)
# OPENROUTER_SITE_URL=https://your-app-url.com
# OPENROUTER_APP_TITLE=BCP Calculator

# Log level
LOG_LEVEL=INFO
