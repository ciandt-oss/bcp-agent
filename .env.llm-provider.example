# BCP Calculator — LLM Gateway Configuration
#
# Use this file when running BCP Calculator against a LLM local gateway
# (e.g., http://127.0.0.1:8788/v1). The gateway handles auth internally,
# so no API key is needed — a placeholder is used to skip the Authorization header.
#
# Copy to .env and adjust as needed:
#   cp .env.llm-provider.example .env

# Provider: uses SimpleLLMProvider (default) with httpx
# No provider name needed — "openai" maps to SimpleLLMProvider

# API key: placeholder — SimpleLLMProvider omits the Authorization header
# when the key is empty or a known placeholder
OPENAI_API_KEY=test-key

# Gateway URL (LLM local gateway)
OPENAI_BASE_URL=http://127.0.0.1:8788/v1

# Model (recommended: mistral-small-2503 with temperature=0 for lowest CV)
OPENAI_MODEL_NAME=mistral-small-2503

# Log level
LOG_LEVEL=INFO
