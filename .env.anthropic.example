# BCP Calculator — Anthropic Claude Configuration
#
# Use this file when running BCP Calculator with Anthropic Claude
# via langchain's ChatAnthropic provider.
#
# Copy to .env and adjust as needed:
#   cp .env.anthropic.example .env

# Provider: use --provider claude on CLI / SDK / API
# This uses ClaudeProvider (langchain-based ChatAnthropic)

# Anthropic API key (required)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Base URL (optional — defaults to https://api.anthropic.com)
# Use this to point to a proxy, gateway, or Anthropic-compatible endpoint
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Model (recommended: mistral-small-2503 with temperature=0 for lowest CV)
# Note: mistral-small-2503 is available via Anthropic's model alias system.
# For native Claude models, use e.g. claude-sonnet-4-6
ANTHROPIC_MODEL_NAME=mistral-small-2503

# Log level
LOG_LEVEL=INFO
