# BCP Calculator — Anthropic Claude Configuration
#
# Use this file when running BCP Calculator with Anthropic Claude
# via langchain's ChatAnthropic provider.
#
# Copy to .env and adjust as needed:
#   cp .env.anthropic.example .env

# Provider: use --provider claude on CLI / SDK / API
# This uses ClaudeProvider (langchain-based ChatAnthropic)

# Anthropic API key (required)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Base URL (optional — defaults to https://api.anthropic.com)
# Use this to point to a proxy, gateway, or Anthropic-compatible endpoint
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Model (default: claude-sonnet-4-6)
ANTHROPIC_MODEL_NAME=claude-sonnet-4-6

# Determinism settings (optional — defaults below maximize determinism for BCP scoring)
# These control Claude's adaptive thinking and reasoning effort.
#
# Thinking config — disables adaptive thinking for maximum determinism
# Default: {"type": "disabled"}
# To enable adaptive thinking: ANTHROPIC_THINKING={"type": "adaptive"}
# To enable thinking with budget: ANTHROPIC_THINKING={"type": "enabled", "budget_tokens": 1024}
ANTHROPIC_THINKING={"type": "disabled"}

# Reasoning effort — controls how much effort the model puts into its response
# Values: low, medium, high, xhigh, max
# Default: low (minimizes reasoning variation for consistent BCP scoring)
ANTHROPIC_REASONING_EFFORT=low

# Log level
LOG_LEVEL=INFO
