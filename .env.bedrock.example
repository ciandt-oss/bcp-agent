# BCP Calculator — AWS Bedrock Configuration (Native)
#
# Use this file when running BCP Calculator against AWS Bedrock directly
# via the BedrockProvider (--provider bedrock).
#
# Copy to .env and adjust as needed:
#   cp .env.bedrock.example .env

# Provider: use --provider bedrock on CLI / SDK / API
# This uses BedrockProvider with native AWS Bedrock Converse API

# AWS Bedrock region (default: us-east-1)
AWS_BEDROCK_REGION=us-east-1

# Bedrock model ID (default: openai.gpt-5.6-luna)
FLOW_BEDROCK_MODEL_NAME=openai.gpt-5.6-luna

# Max tokens (default: 4096)
FLOW_BEDROCK_MAX_TOKENS=4096

# Temperature (recommended: 0 for deterministic output)
FLOW_BEDROCK_TEMPERATURE=0

# Auth option A: Short-term token via aws_bedrock_token_generator (recommended)
# The token generator auto-refreshes before expiry. No env var needed —
# it uses your AWS credentials internally.
# Install: pip install aws-bedrock-token-generator

# Auth option B: Pre-set bearer token (skip token generator)
# Set this if you have a long-term API key or want to bypass the token generator.
AWS_BEARER_TOKEN_BEDROCK=your_api_key_here

# Log level
LOG_LEVEL=INFO
